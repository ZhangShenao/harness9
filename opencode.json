{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "go build *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "go run *": "allow",
      "go mod *": "allow",
      "go get *": "allow",
      "go list *": "allow",
      "go tool *": "allow",
      "go doc *": "allow",
      "go version*": "allow",
      "gofmt *": "allow",
      "goimports *": "allow",
      "goreleaser --version": "allow",
      "goreleaser check *": "allow",
      "goreleaser build *": "allow",
      "gh workflow *": "allow"
    },
    "webfetch": "allow"
  }
}
