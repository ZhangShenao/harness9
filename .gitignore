.DS_Store
.env
# 编译产物：必须用前导 / 锚定到仓库根，避免误伤 cmd/harness9 目录
/harness9
# GoReleaser 构建输出目录
dist/

# Superpowers / AI 工具生成的临时文档，仅供开发会话内参考，不纳入版本控制
docs/superpowers/
docs/specs/

# Claude Code 本地权限/会话配置，因机器和会话而异，不纳入版本控制
.claude/settings.local.json

# Deep Research 生成的调研报告
reports/

# harness9 运行时数据（会话 DB、tool_results offload、plans）
.harness9/

# 本地临时目录
tmp/

# autodev：git worktree 临时工作区（/autodev 命令生成）
.autodev/

# VitePress 网站依赖与构建产物
website/node_modules/
website/.vitepress/dist/
website/.vitepress/cache/
website/docs/
website/.vitepress/sidebar.generated.js
website/zh/docs/
website/package-lock.json

/swebench

logs/

# SWE-bench 数据集文件（体积大，不纳入版本控制）
swe-bench-lite.jsonl

# SWE-bench 运行产物（predictions / trajectory 日志 / run_summary / 官方评分 JSON），均为生成物
swebench-results/
*.harness9-lite-*.json

# Terminal-Bench (Harbor) pilot：预编译二进制与评测结果均为生成物，不纳入版本控制
benchmarks/terminal_bench/bin/
benchmarks/terminal_bench/runs/

# Python 字节码缓存（本仓库首次引入 Python 源码，benchmarks/ 下的 Harbor 适配器）
__pycache__/
*.pyc
